# Copiar a /etc/kairos/kairos.env en el servidor (chmod 600). Nunca se sube al repo.
# Referencia de cada variable: docs/guia/configuracion.md

# Dirección pública con la que la gente abre Kairos (sin barra final).
PUBLIC_URL=https://kairos.example.com

# Puerto local en el que escucha «web»; el proxy inverso con HTTPS apunta aquí.
WEB_PORT=8081

# Base de datos. Contraseña larga sin caracteres especiales de URL (@ : / ? # %),
# porque va dentro de DATABASE_URL.
POSTGRES_USER=kairos
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
POSTGRES_DB=kairos

# --- Acceso ---
# local | oidc | both
AUTH_MODE=local
# Obligatoria, al menos 32 bytes: openssl rand -base64 48
# También cifra las contraseñas de SMTP, SSO y S3 guardadas en Sistema: no la cambies después.
SESSION_SECRET=
# Quien entre o se registre con este correo se convierte en administrador mientras no haya otro.
BOOTSTRAP_ADMIN_EMAIL=
# true solo para la primera cuenta; luego se desactiva en Sistema → Acceso.
REGISTRATION_ENABLED=true
DEFAULT_ROLE=member

# --- SSO (solo con AUTH_MODE oidc o both) ---
# OIDC_REDIRECT_URL = <PUBLIC_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ROLE_SOURCE=idp
OIDC_LINK_BY_EMAIL=false

# --- Archivos de las páginas en S3 (opcional; vacío = en la base de datos) ---
# FILES_S3_ENDPOINT=s3.example.com
# FILES_S3_BUCKET=kairos
# FILES_S3_REGION=
# FILES_S3_ACCESS_KEY=
# FILES_S3_SECRET_KEY=
# FILES_S3_USE_SSL=true
