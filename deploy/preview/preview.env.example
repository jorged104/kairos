# Copiar a ~/kairos/preview.env en el servidor (chmod 600). Nunca se sube al repo.

# Hostname público (privado: no lo pongas en el repo ni en GitHub).
PREVIEW_HOST=preview.example.com

# Red Docker de Traefik y entrypoint por el que entra el túnel de Cloudflare.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=web

# Credenciales de la BD de previsualización. Usa una contraseña larga sin
# caracteres especiales de URL (@ : / ? # %), porque va dentro de DATABASE_URL.
POSTGRES_USER=kairos
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
POSTGRES_DB=kairos

# --- Autenticación (spec 003) ---
# local | oidc | both. Obligatoria: sin ella el despliegue falla y sigue la versión anterior.
AUTH_MODE=local
# Obligatoria. Genera una propia: openssl rand -base64 48
SESSION_SECRET=
# Email que se convierte en admin la primera vez (mientras no haya ningún admin activo).
BOOTSTRAP_ADMIN_EMAIL=
REGISTRATION_ENABLED=false
DEFAULT_ROLE=member

# Solo con AUTH_MODE oidc o both. OIDC_REDIRECT_URL = https://<PREVIEW_HOST>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ROLE_SOURCE=idp
OIDC_LINK_BY_EMAIL=false
