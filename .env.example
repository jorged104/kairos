# Copia este fichero a .env para desarrollo local. No guardes credenciales reales.

POSTGRES_USER=openscum
POSTGRES_PASSWORD=openscum
POSTGRES_DB=openscum
POSTGRES_PORT=5432

# Usada por la API y por goose cuando se ejecutan en el host.
DATABASE_URL=postgres://openscum:openscum@localhost:5432/openscum?sslmode=disable

API_PORT=8080
WEB_PORT=5173

# Destino del proxy de Vite cuando el frontend corre en el host.
API_PROXY_TARGET=http://localhost:8080

# BD administrativa para los tests de integración: cada test crea y borra su propia BD.
TEST_DATABASE_URL=postgres://openscum:openscum@localhost:5432/openscum?sslmode=disable

# --- Autenticación (spec 003) ---
# local | oidc | both
AUTH_MODE=local
# Solo para desarrollo: genera uno propio fuera de local (>= 32 bytes).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Origen del frontend: CSRF, WebSocket y redirecciones.
PUBLIC_URL=http://localhost:5173
# Solo en desarrollo sobre http; fuera de desarrollo debe ser true.
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Rol por defecto; vacío = rechazar el login de usuarios sin rol.
DEFAULT_ROLE=member
BOOTSTRAP_ADMIN_EMAIL=admin@kairos.local

# --- OIDC (solo con AUTH_MODE oidc o both) ---
# make up-sso levanta Keycloak en KEYCLOAK_PORT con el realm de scripts/keycloak/
# (usuarios ana, bruno, carla y admin; contraseña kairos-dev-123).
KEYCLOAK_PORT=8180
OIDC_ISSUER=http://localhost:8180/realms/kairos
# Cómo ve la API al IdP si es distinto del issuer (la API en contenedor).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=kairos
# Solo para desarrollo: coincide con scripts/keycloak/realm-export.json.
OIDC_CLIENT_SECRET=dev-only-kairos-client-secret
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/oidc/callback
OIDC_ROLE_SOURCE=idp
OIDC_LINK_BY_EMAIL=true
