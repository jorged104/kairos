# Copia este fichero a .env para desarrollo local. No guardes credenciales reales.

POSTGRES_USER=openscum
POSTGRES_PASSWORD=openscum
POSTGRES_DB=openscum
POSTGRES_PORT=5432

# Usada por la API y por goose cuando se ejecutan en el host.
DATABASE_URL=postgres://openscum:openscum@localhost:5432/openscum?sslmode=disable

API_PORT=8080
WEB_PORT=5173

# Destino del proxy de Vite cuando el frontend corre en el host.
API_PROXY_TARGET=http://localhost:8080
